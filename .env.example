# Clerk (auth) — https://dashboard.clerk.com → API Keys
# Enable Organizations in your Clerk dashboard; each org = one wedding.
CLERK_SECRET_KEY=
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up

# Postgres — https://neon.tech → your project's connection string
DATABASE_URL=

# Resend (email) — https://resend.com/api-keys
RESEND_API_KEY=

# Any random string you generate yourself, e.g. `openssl rand -hex 32`.
# Vercel Cron sends this automatically as a bearer token once it's set.
CRON_SECRET=
